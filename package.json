{
  "name": "carscanner",
  "version": "0.1.0",
  "description": "Car window sticker scanner and deal analyzer",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:node": "tsx watch src/index.ts",
    "start": "bun src/index.ts",
    "start:node": "node --loader tsx src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@hono/node-server": "^1.8.0",
    "@hono/zod-validator": "^0.2.0",
    "zod": "^3.22.4",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "prettier": "^3.2.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0"
  }
}
