# OpenAI API Key (required for OCR)
OPENAI_API_KEY=sk-your-key-here

# NHTSA API Base URL (free, no key needed)
NHTSA_API_BASE=https://vpic.nhtsa.dot.gov/api

# Market API (optional for MVP - can use mock data)
MARKET_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Database (Bun SQLite)
DB_PATH=./data/carscanner.db

# Image Upload
MAX_IMAGE_SIZE_MB=10
UPLOAD_DIR=./uploads
